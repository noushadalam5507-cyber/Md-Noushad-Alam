{
  "expo": {
    "name": "NovaGrand Pro",
    "slug": "novagrand-pro",
    "owner": "noushadalam5507",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#05070e"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.instagrand.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow NovaGrand to access your camera for 4K video calls and photo posts.",
        "NSMicrophoneUsageDescription": "Allow NovaGrand to access your microphone for HD audio/video calls.",
        "NSPhotoLibraryUsageDescription": "Allow NovaGrand to access your photos to upload media and set wallpapers."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05070e"
      },
      "package": "com.instagrand.app",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NovaGrand to access your photos to share media.",
          "cameraPermission": "Allow NovaGrand to access your camera to record 4K reels."
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "7886bbde-0d83-49f3-bbba-7ff9e8febcfe"
      }
    }
  }
}
